# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL (use a dedicated app user, not root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=flipmycart_app
DB_PASSWORD=Pothalae03@
DB_NAME=flipmycart

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/flipmycart

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
